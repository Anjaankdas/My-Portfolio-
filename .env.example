# ---- এই file কপি করে .env.local নাম দাও (local test-এর জন্য) ----
# Vercel-এ: Project → Settings → Environment Variables-এ একই নাম দিয়ে বসাও

# তোমার site-এর আসল link (deploy-এর পর বসাও)
NEXT_PUBLIC_SITE_URL=https://anjan-das.vercel.app

# Contact form — https://web3forms.com থেকে free access key (email দিলেই পাবে)
NEXT_PUBLIC_WEB3FORMS_KEY=

# AI Chatbot — অন্তত একটা লাগবে
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq key (backup): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Rate limit (spam ঠেকাতে) — https://console.upstash.com → Redis database বানাও → REST URL/Token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
